{
  "name": "stock-tracking",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "dev": "node -e \"const fs=require('fs');if(!fs.existsSync('dist'))fs.mkdirSync('dist');if(fs.existsSync('index.html'))fs.copyFileSync('index.html','dist/index.html');\" && tauri dev",
    "build": "node -e \"const fs=require('fs');if(!fs.existsSync('dist'))fs.mkdirSync('dist');if(fs.existsSync('index.html'))fs.copyFileSync('index.html','dist/index.html');\" && tauri build",
    "copy-ui": "node -e \"const fs=require('fs');if(!fs.existsSync('dist'))fs.mkdirSync('dist');fs.copyFileSync('index.html','dist/index.html');console.log('UI copied to dist/');""
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
